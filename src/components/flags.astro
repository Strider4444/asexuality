---
import AceFlag from "@assets/images/AceFlag.webp";
import AceFlagBlur from "@assets/images/AceFlagBlur.webp";

let flags = [
  {
    name: "Asexual Flag",
    path: AceFlag.src,
  },
  {
    name: "Other Flag",
    path: AceFlagBlur.src,
  },
];
---

<section class="flags">
  {flags.map((flag) => (
    <img
      src={flag.path}
      title={flag.name}
      alt={flag.name}
      width="64"
      height="36"
    />
  ))}
</section>

<style>
  .flags {
    margin-inline: auto;
    padding-block: var(--num-m);
    display: flex;
    gap: var(--num-s);
    max-inline-size: var(--inline-size);

    > img {
      border: 1px solid var(--clr-secondary);
    }
  }
</style>
