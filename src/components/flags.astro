    path: Demi.src,
    link: "#", //placeholder link should link to the lgbtq wiki of the flag
  },
];

function shuffle(array: any) {
  for (let flag in flags) {
    let currentFlag = flags.at(Number(flag));
    let currentIndex = flags.map((flg) => flg.name).indexOf(currentFlag!.name);

    let randomIndex = Math.floor(Math.random() * currentIndex);

    [flags[currentIndex], flags[randomIndex]] = [
      flags[randomIndex],
      flags[currentIndex],
    ];
  }
  flags.pop();
  flags.pop();
}

shuffle(flags);
---

<section class="flags">
  {flags.map((flag) => (
    <a href={flag.link} target="_blank">
      <img
        src={flag.path}
        title={flag.name}
        alt={flag.name}
        width="64"
        height="36"
      />
    </a>
  ))}
</section>

<style>
  .flags {
    margin-inline: auto;
    padding-block: var(--num-m);
    display: flex;
    justify-content: space-between;
    gap: var(--num-s);
    max-inline-size: var(--inline-size);

    > a {
      border: 1px solid var(--clr-secondary);
    }

    @media screen and (width <= 850px) {
      padding-inline: var(--num-s);
    }

    /* nth-of-type(n+x) makes it so only that number - 1 shows up*/
    @media screen and (width <= 1150px) {
      > a:nth-of-type(n + 11) {
        display: none;
      }
    }

    @media screen and (width < 720px) {
      > a:nth-of-type(n + 6) {
        display: none;
      }
    }
  }
</style>
