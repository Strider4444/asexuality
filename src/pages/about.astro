---
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <section>
    <div>
      <h1>About us</h1>
      <p>
        Our goal is to make Asexuality more accessible and easier to understand,
        because there is litle accessible, well structurerd information about us
        on the web. We are a small team of Aces keeping this site up and
        running, we would love to hear some feedback from you to improve the
        website.
      </p>
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(1.75em, 1.5em + 1vw, 2.75em);
    color: var(--clr-text-accent);
    margin-bottom: var(--num-l);
  }
</style>
